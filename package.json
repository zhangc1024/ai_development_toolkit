{
  "name": "dev-toolkit",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "vue-tsc --noEmit && vite build --config vite.desktop.config.ts",
    "desktop:preview": "electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --win --x64 --dir --publish never",
    "desktop:test": "node --test tests/desktop-protocol.cjs tests/desktop-files.cjs tests/desktop-batch.cjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:dist": "npm run desktop:build && electron-builder --win zip --x64 --publish never",
    "desktop:dist:installer": "npm run desktop:build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "@lucide/vue": "^1.46.0",
    "@noble/hashes": "^2.4.0",
    "@zip.js/zip.js": "^2.15.0",
    "codemirror": "^6.0.0",
    "diff": "^9.0.0",
    "entities": "^8.1.0",
    "exifr": "^7.1.3",
    "imagequant": "^0.1.2",
    "jsonc-parser": "^3.3.1",
    "jsqr": "^1.4.0",
    "libheif-js": "^1.23.2",
    "libraw-wasm": "1.6.0",
    "luxon": "^3.7.2",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "sql-formatter": "^15.8.2",
    "utif": "^3.1.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "fake-indexeddb": "^6.2.6",
    "playwright-core": "1.64.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.0"
  },
  "main": "electron/main.cjs",
  "description": "离线本地图片工具（Windows 内测版）"
}
